{
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      }
    },
    "live-apk": {
      "distribution": "internal",
      "environment": "production",
      "developmentClient": false,
      "android": {
        "buildType": "apk"
      }
    }
  },
  "cli": {
    "appVersionSource": "local"
  }
}
