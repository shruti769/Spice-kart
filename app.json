{
  "expo": {
    "name": "SpiceKart",
    "slug": "Spice-kart",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/brand/app-icon.png",
    "scheme": "spicekart",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/brand/app-icon.png",
      "supportsTablet": false,
      "bundleIdentifier": "com.komal92.spicekart",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "remote-notification",
          "fetch",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#08351A",
        "foregroundImage": "./assets/images/brand/app-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.komal92.spicekart",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/brand/app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#052E1B",
          "image": "./assets/images/brand/splash-blank.png",
          "imageWidth": 8
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "SpiceKart uses your photos so you can set a profile picture or attach a photo to a support request.",
          "cameraPermission": "SpiceKart uses the camera so you can take a profile picture or a photo of an item for support."
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#0B3D1F",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SpiceKart uses your location to fill in your delivery address, check that we deliver to you, and record where an order was placed from."
        }
      ],
      "@react-native-firebase/app/app.plugin.js",
      "@react-native-firebase/auth/app.plugin.js",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.komal92.spicekart",
          "enableGooglePay": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b986aec1-71be-4364-9117-95821d988081"
      }
    }
  }
}
