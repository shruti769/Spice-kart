{
  "expo": {
    "name": "Spice Kart",
    "slug": "Spice-kart",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/brand/app-icon.png",
    "scheme": "spicekart",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/brand/app-icon.png",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#08351A",
        "foregroundImage": "./assets/images/brand/app-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.komal92.spicekart"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/brand/app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#08351A",
          "image": "./assets/images/brand/app-icon.png",
          "imageWidth": 88
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Spice Kart uses your photos so you can set a profile picture or attach a photo to a support request.",
          "cameraPermission": "Spice Kart uses the camera so you can take a profile picture or a photo of an item for support."
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b986aec1-71be-4364-9117-95821d988081"
      }
    }
  }
}
